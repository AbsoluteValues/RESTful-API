pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'DEPLOY_HOST', defaultValue: 'myhomedevserver.com', description: 'Deployment server hostname')
        string(name: 'DEPLOY_PORT', defaultValue: '20000', description: 'Deployment server SSH port')
        string(name: 'DEPLOY_DIR', defaultValue: '/home/foxy/docker/springboot/restful', description: 'Docker Compose directory on the deployment server')
    }

    environment {
        IMAGE_NAME = 'absolutevalues/restful-api'
    }

    stages {
        stage('Test') {
            steps {
                dir('RESTful') {
                    sh './gradlew clean test'
                }
            }
        }

        stage('Build And Push Image') {
            steps {
                dir('RESTful') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credential',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )]) {
                        sh '''
                            ./gradlew jib --no-daemon \
                              -Djib.to.image=$IMAGE_NAME:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'deploy-ssh-key',
                    keyFileVariable: 'SSH_PRIVATE_KEY',
                    usernameVariable: 'DEPLOY_USER'
                )]) {
                    sh '''
                        set -eu
                        known_hosts=$(mktemp)
                        trap 'rm -f "$known_hosts"' EXIT

                        ssh-keyscan -H -p "$DEPLOY_PORT" "$DEPLOY_HOST" > "$known_hosts"
                        ssh \
                          -i "$SSH_PRIVATE_KEY" \
                          -p "$DEPLOY_PORT" \
                          -o BatchMode=yes \
                          -o StrictHostKeyChecking=yes \
                          -o UserKnownHostsFile="$known_hosts" \
                          "$DEPLOY_USER@$DEPLOY_HOST" \
                          "set -eu
                           cd '$DEPLOY_DIR'
                           docker compose pull springboot
                           docker compose up -d --no-deps springboot

                           container_id=\$(docker compose ps -q springboot)
                           if [ -z \"\$container_id\" ]; then
                               echo 'Spring Boot container was not created.' >&2
                               exit 1
                           fi

                           attempt=1
                           while [ \"\$attempt\" -le 30 ]; do
                               if docker exec \"\$container_id\" \
                                   wget -qO- http://127.0.0.1:8081/actuator/health 2>/dev/null \
                                   | grep -q '\"status\":\"UP\"'; then
                                   docker compose ps springboot
                                   exit 0
                               fi

                               if [ \"\$(docker inspect -f '{{.State.Running}}' \"\$container_id\")\" != 'true' ]; then
                                   break
                               fi

                               attempt=\$((attempt + 1))
                               sleep 2
                           done

                           echo 'Spring Boot health check failed.' >&2
                           docker compose logs --tail=100 springboot >&2
                           exit 1"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Deployed $IMAGE_NAME:latest"
        }

        failure {
            echo 'Pipeline failed'
        }
    }
}
