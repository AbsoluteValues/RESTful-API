void sendDiscordNotification(String result, int color) {
    def payload = groovy.json.JsonOutput.toJson([
        embeds: [[
            title      : "${env.APP_NAME ?: env.JOB_NAME} ${result}",
            description: "${env.JOB_NAME} #${env.BUILD_NUMBER}",
            url        : env.BUILD_URL,
            color      : color,
            fields     : [
                [name: 'Image', value: "${env.IMAGE_NAME}:latest", inline: true],
                [name: 'Deploy Host', value: env.DEPLOY_HOST, inline: true],
                [name: 'Branch', value: env.BRANCH_NAME ?: 'N/A', inline: true]
            ],
            timestamp  : new Date().format("yyyy-MM-dd'T'HH:mm:ssXXX", TimeZone.getTimeZone('Asia/Seoul'))
        ]]
    ])

    writeFile file: 'discord-payload.json', text: payload

    withCredentials([string(credentialsId: 'discord-webhook-url', variable: 'DISCORD_WEBHOOK_URL')]) {
        sh '''
            curl -fsS \
              -H 'Content-Type: application/json' \
              --data-binary @discord-payload.json \
              "$DISCORD_WEBHOOK_URL"
        '''
    }
}

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'APP_NAME', defaultValue: 'RESTful', description: 'Application name used in logs and notifications')
        string(name: 'PROJECT_DIR', defaultValue: 'RESTful', description: 'Gradle project directory from the repository root')
        string(name: 'IMAGE_NAME', defaultValue: 'absolutevalues/restful-api', description: 'Container image name without tag')
        string(name: 'DEPLOY_HOST', defaultValue: 'myhomedevserver.com', description: 'Deployment server hostname')
        string(name: 'DEPLOY_PORT', defaultValue: '20000', description: 'Deployment server SSH port')
        string(name: 'DEPLOY_DIR', defaultValue: '/home/foxy/docker/springboot/restful', description: 'Docker Compose directory on the deployment server')
        string(name: 'COMPOSE_SERVICE', defaultValue: 'springboot', description: 'Docker Compose service to update')
        string(name: 'DOCKERHUB_CREDENTIAL_ID', defaultValue: 'DockerHub-Auth', description: 'Jenkins credential ID for Docker Hub')
        string(name: 'DEPLOY_CREDENTIAL_ID', defaultValue: 'deploy-ssh-key', description: 'Jenkins SSH credential ID for deployment')
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }

        stage('Test') {
            steps {
                dir(params.PROJECT_DIR) {
                    sh './gradlew clean test'
                }
            }
        }

        stage('Build') {
            steps {
                echo "Build and push ${params.APP_NAME} image"

                dir(params.PROJECT_DIR) {
                    withCredentials([usernamePassword(
                        credentialsId: params.DOCKERHUB_CREDENTIAL_ID,
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )]) {
                        sh '''
                            ./gradlew jib --no-daemon \
                                -Djib.to.image=$IMAGE_NAME:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploy ${params.APP_NAME} service"

                withCredentials([sshUserPrivateKey(
                    credentialsId: params.DEPLOY_CREDENTIAL_ID,
                    keyFileVariable: 'SSH_PRIVATE_KEY',
                    usernameVariable: 'DEPLOY_USER'
                )]) {
                    sh '''
                        set -eu
                        known_hosts=$(mktemp)
                        trap 'rm -f "$known_hosts"' EXIT

                        ssh-keyscan -H -p "$DEPLOY_PORT" "$DEPLOY_HOST" > "$known_hosts"
                        ssh \
                            -i "$SSH_PRIVATE_KEY" \
                            -p "$DEPLOY_PORT" \
                            -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            -o UserKnownHostsFile="$known_hosts" \
                            "$DEPLOY_USER@$DEPLOY_HOST" \
                            "cd '$DEPLOY_DIR' &&
                            docker compose pull '$COMPOSE_SERVICE' &&
                            docker compose up -d --no-deps '$COMPOSE_SERVICE' &&
                            docker compose ps '$COMPOSE_SERVICE'"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Deployed $IMAGE_NAME:latest"
            script {
                sendDiscordNotification('Deploy Succeeded', 3066993)
            }
        }

        failure {
            echo 'Pipeline failed'
            script {
                sendDiscordNotification('Pipeline Failed', 15158332)
            }
        }
    }
}
