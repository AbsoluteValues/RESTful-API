<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.AbsoluteValue.RESTful.user.mapper.UserMapper">

    <insert id="signUpUser">
        INSERT INTO USER_TBL VALUES (#{id}, #{password}, #{nickname}, null, null, null, null)
    </insert>

    <select id="getUserInfo" resultType="User">
        SELECT * FROM USER_TBL WHERE ID = #{id}
    </select>

</mapper>